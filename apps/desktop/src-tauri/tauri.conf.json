{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockML",
  "version": "0.4.0",
  "identifier": "dev.blockml.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlockML",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["blockml"],
        "name": "BlockML Diagram",
        "description": "BlockML architecture diagram",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
